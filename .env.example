OLLAMA_MODEL=qwen3.5:4b-q4_K_M
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
VLM_PROVIDER=ollama
VLM_MODEL=qwen3.5:4b-q4_K_M
VISUAL_EMBEDDINGS=
VISUAL_EMBEDDING_MODEL=sentence-transformers/clip-ViT-B-32-multilingual-v1
VISUAL_IMAGE_MODEL=clip-ViT-B-32
LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_KEEP_ALIVE=15m
RAG_EMBED_BATCH_SIZE=16
RAG_MIN_SEMANTIC_SCORE=0.40
RAG_MIN_LEXICAL_COVERAGE=0.30
RAG_TEMPERATURE=0
RAG_QUERY_ANALYSIS=heuristic
RAG_NUM_CTX=8192
RAG_NUM_PREDICT=700
RAG_MAX_CONTEXT_CHARS=18000
RAG_CHUNK_SIZE=240
RAG_CHUNK_OVERLAP=40
RAG_RERANK=true
RERANKER_PROVIDER=diversify
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_PATH=models/reranker
GUTENDEX_BASE_URL=https://gutendex.com
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_ENABLED=false
QDRANT_ENABLED=false
QDRANT_URL=http://127.0.0.1:6333
POSTGRES_ENABLED=false
DATABASE_URL=
MLFLOW_ENABLED=false
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
AUTH_ENABLED=false
JWT_SECRET=
APPROVAL_SECRET=
MAX_MODEL_CALLS_PER_REQUEST=6
MAX_MCP_CALLS_PER_REQUEST=3
MAX_IMAGE_BYTES=10485760
MAX_CONTEXT_TOKENS=8192
REQUEST_TIMEOUT_SECONDS=60
OCR_ENABLED=false

# Profil intégré : installer les extras orchestration et mcp.
MCP_TRANSPORT=stdio
MAX_CONCURRENT_INFERENCE=1
